rules_version = '2';

// O browser só lê os dados públicos da liga.
// Todas as escritas passam pela API (Cloudflare), que usa uma conta de serviço
// e por isso não está sujeita a estas regras.
service cloud.firestore {
  match /databases/{database}/documents {
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if false;

      match /{sub=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Qual é a época atual (escrito pela importação).
    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    // Tudo o resto: fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
